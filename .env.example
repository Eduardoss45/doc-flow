# --- Compose / infra ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=df_document_processor_db

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

REDIS_URL=redis://redis:6379/0
TIMEZONE=America/Sao_Paulo
ALLOWED_ORIGINS=http://localhost:3000

# --- App (API / worker; Compose monta DATABASE_URL e RABBITMQ_URL a partir das vars acima) ---
# Para rodar a API fora do Docker, use URLs apontando para localhost:
# DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/df_document_processor_db
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# REDIS_URL=redis://localhost:6379/0

FLASK_HOST=0.0.0.0
FLASK_PORT=4000
FLASK_DEBUG=false
FLASK_ENV=production

# Markdown → PDF / imagens
ALLOWED_IMAGE_DOMAINS=raw.githubusercontent.com,githubusercontent.com,cdn.jsdelivr.net,images.unsplash.com
ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp,image/gif
MAX_IMAGE_SIZE=5242880
MAX_MARKDOWN_SIZE=5242880
MAX_MARKDOWN_LINES=20000
MAX_MARKDOWN_IMAGES=20
MAX_RENDERED_HTML_SIZE=5242880
MAX_HTML_NODES=50000
MARKDOWN_PDF_DEBUG_HTML=false