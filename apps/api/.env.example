# Host onde a aplicação será exposta
HOST=0.0.0.0

# Porta da aplicação
PORT=4000

# Timezone padrão da aplicação
TIMEZONE=America/Sao_Paulo

# Banco de Dados (PostgreSQL)
# Formato:
# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/df_document_processor_db

# RabbitMQ
# Formato:
# amqp://USER:PASSWORD@HOST:PORT
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Redis
# Formato:
# redis://HOST:PORT/DB_INDEX
REDIS_URL=redis://localhost:6379/0

# CORS
# Origem permitida para requisições do frontend
# Para múltiplas origens, separar por vírgula
ALLOWED_ORIGINS=http://localhost:3000

# REQUESTS EXTERNOS PERMITIDOS
# Lista de domínios externos permitidos para requisições no backend
# Para múltiplos domínios, separar por vírgula
ALLOWED_IMAGE_DOMAINS=raw.githubusercontent.com,githubusercontent.com,cdn.jsdelivr.net,images.unsplash.com

# TIPOS DE IMAGENS E TAMANHO MÁXIMO
ALLOWED_IMAGE_TYPES = {
    "image/png",
    "image/jpeg",
    "image/webp",
    "image/gif",
}
MAX_IMAGE_SIZE = 5 * 1024 * 1024